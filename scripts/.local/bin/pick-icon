INSTRUCTIONS = """\
Choose an icon to show next to a name, such as the name of a terminal tab, \
session or project. Choose the icon whose meaning best matches the name. \
Consider what the name literally says, what kind of work it suggests, and any \
well-known associations. If nothing fits well, choose the closest in mood or \
theme.

Icons:
""" + "\n".join(f"{icon_id}: {meaning}" for icon_id, (_, meaning) in ICONS.items())

CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "pick-icon"
)

CACHE_PATH = os.path.join(CACHE_DIR, "icons.json")

# Changing the icons or instructions invalidates the cache
CACHE_VERSION = zlib.crc32(json.dumps([ICONS, INSTRUCTIONS]).encode())

# Cached for names the model declines to pick an icon for
DECLINED = ""

# Xcode is required to build the SDK from source
# https://apple.github.io/python-apple-fm-sdk/
SDK = "apple-fm-sdk==0.2.1"

# Set for the run of this script that has the SDK
WITH_SDK_ENV = "PICK_ICON_WITH_SDK"

# Where the Mac App Store installs Xcode's developer directory
XCODE_DEVELOPER_DIR = "/Applications/Xcode.app/Contents/Developer"

WARNINGS = {
    "xcode-missing": (
        "Xcode not found. Install with the Mac App Store "
        "to use intelligent icon selection."
    ),
    "xcode-unselected": (
        "Xcode found, but the Command Line Tools are selected. "
        f"Run 'sudo xcode-select -s {XCODE_DEVELOPER_DIR}' "
        "to use intelligent icon selection."
    ),
    "xcode-outdated": (
        "Xcode {version} found, but 26 or later is needed. "
        "Update with the Mac App Store to use intelligent icon selection."
    ),
    "xcode-license": (
        "Xcode license not accepted. Run 'sudo xcodebuild -license accept' "
        "to use intelligent icon selection."
    ),
    "sdk": (
        "Couldn't install or load Foundation Models SDK for Python. Run pick-icon in a terminal "
        "to see why."
    ),
    "model-disabled": (
        "Apple Intelligence not enabled. Turn on in System Settings > "
        "Apple Intelligence & Siri to use intelligent icon selection."
    ),
    "model-not-ready": (
        "Apple Intelligence model not ready, it may still be downloading. "
        "Falling back to hash-based icon selection."
    ),
    "model-unavailable": (
        "Apple Intelligence model unavailable. Falling back to hash-based icon selection."
    ),
}

# Warning kinds for the SDK's reasons the model is unavailable. Ineligible
# devices aren't warned about, like Macs without macOS 26.
MODEL_UNAVAILABLE_WARNINGS = {
    "APPLE_INTELLIGENCE_NOT_ENABLED": "model-disabled",
    "MODEL_NOT_READY": "model-not-ready",
    "UNKNOWN": "model-unavailable",
}

# Only send each kind of warning notification once - do not warn if its file exists
WARNED_PATH = os.path.join(CACHE_DIR, ".warned-{kind}")


class Arguments(argparse.Namespace):
    names: list[str] = []
    refresh: bool = False


def parse_arguments() -> Arguments:
    parser = argparse.ArgumentParser(
        description="Print an icon for each name, one per line in the same order."
    )
    _ = parser.add_argument("names", nargs="+", metavar="NAME")
    _ = parser.add_argument(
        "--refresh",
        action="store_true",
        help="have the model pick the names' icons anew rather than use cached ones",
    )
    return parser.parse_args(namespace=Arguments())


def hashed_icon(name: str) -> str:
    # zlib.crc32 gives a consistent int value that we can index with
    icons = list(ICONS.values())
    return icons[zlib.crc32(name.encode()) % len(icons)][0]


def model_supported() -> bool:
    """Whether this is a Mac with Apple's Foundation Models framework."""
    if sys.platform != "darwin":
        return False

    try:
        return int(platform.mac_ver()[0].split(".")[0]) >= 26
    except ValueError:
        return False


def xcode_warning() -> tuple[str, str] | None:
    """The kind and message of a warning if the active developer directory
    isn't a full Xcode 26 or later with its license accepted, which the SDK's
    build requires. Unlike running swift, xcode-select never offers to install
    the Command Line Tools."""
    try:
        developer_dir = subprocess.run(
            ["xcode-select", "-p"], capture_output=True, text=True, check=True
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        developer_dir = ""

    if not developer_dir or "CommandLineTools" in developer_dir:
        # The build doesn't use Xcode unless it's selected, even when installed
        if os.path.isdir(XCODE_DEVELOPER_DIR):
            return "xcode-unselected", WARNINGS["xcode-unselected"]

        return "xcode-missing", WARNINGS["xcode-missing"]

    xcodebuild = os.path.join(developer_dir, "usr/bin/xcodebuild")

    try:
        output = subprocess.run(
            [xcodebuild, "-version"],
            capture_output=True,
            text=True,
            check=True,
            timeout=30,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None  # Leave it to the build

    match = re.search(r"Xcode\s+(\d+)(\.\d+)*", output)

    if match and int(match.group(1)) < 26:
        version = match.group(0).split()[1]
        return "xcode-outdated", WARNINGS["xcode-outdated"].format(version=version)

    # Exits non-zero only when the license isn't accepted
    try:
        accepted = (
            subprocess.run(
                [xcodebuild, "-license", "check"], capture_output=True, timeout=30
            ).returncode
            == 0
        )
    except (OSError, subprocess.SubprocessError):
        return None  # Leave it to the build

    if not accepted:
        return "xcode-license", WARNINGS["xcode-license"]

    return None


def warn(kind: str, message: str | None = None) -> None:
    """Warns that the model isn't used, with WARNINGS[kind] unless a message
    is given."""
    message = message or WARNINGS[kind]

    if sys.stderr.isatty():
        print(f"\033[33m{message}\033[0m", file=sys.stderr)
        return

    # If this script is executed non-interactively (e.g. by kitty), notify that we aren't
    # using the Foundation model.
    warned_path = WARNED_PATH.format(kind=kind)

    if os.path.exists(warned_path):
        return

    try:
        os.makedirs(CACHE_DIR, exist_ok=True)

        with open(warned_path, "w"):
            pass

        subprocess.run(
            [
                "osascript",
                "-e",
                "on run argv",
                "-e",
                "display notification (item 1 of argv) with title (item 2 of argv)",
                "-e",
                "end run",
                message,
                "pick-icon",
            ],
            capture_output=True,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def pick_with_model(names: list[str]) -> None:
    """Has the model pick icons for names and caches them, in a run of this
    script with the SDK, which uv builds on first use and caches."""
    uv = os.environ.get("UV") or shutil.which("uv")

    if uv is None:
        return

    # Show build errors when run from a terminal, otherwise there is no one to read them.
    # That run warns itself if the model is unavailable, its stderr is ours to warn on.
    result = subprocess.run(
        [uv, "run", "--quiet", "--with", SDK, "--script", __file__, "--", *names],
        env={**os.environ, WITH_SDK_ENV: "1"},
        stdout=subprocess.DEVNULL,
        stderr=None if sys.stderr.isatty() else subprocess.DEVNULL,
        check=False,
    )

    # Fails if uv can't install the SDK or that run can't load it
    if result.returncode != 0:
        warn("sdk")


def load_model():
    """The Foundation Models SDK if the on-device model is available, otherwise
    warns why not. Errors loading the SDK are left to fail this run."""
    import apple_fm_sdk as fm

    available, reason = fm.SystemLanguageModel().is_available()

    if not available:
        if (kind := MODEL_UNAVAILABLE_WARNINGS.get(reason.name)) is not None:
            warn(kind)

        return None

    return fm


async def model_icon_ids(fm, names: list[str]) -> dict[str, str]:
    """Icon ids picked by the model, DECLINED where it declined to pick one.
    Names that failed for other reasons, such as rate limiting, are left out
    so that they are retried next time."""

    @fm.generable("An icon")
    class Choice:
        icon: str = fm.guide("The chosen icon's id", anyOf=list(ICONS))

    icon_ids = {}

    for name in names:
        # A fresh session per name, so earlier names don't influence later ones
        session = fm.LanguageModelSession(instructions=INSTRUCTIONS)

        try:
            response = await session.respond(f"Name: {name}", generating=Choice)

            if response.icon in ICONS:
                icon_ids[name] = response.icon
        except (
            fm.RefusalError,
            fm.GuardrailViolationError,
            fm.UnsupportedLanguageOrLocaleError,
        ):
            icon_ids[name] = DECLINED
        except fm.FoundationModelsError:
            pass

    return icon_ids


def read_cache() -> dict[str, str]:
    try:
        with open(CACHE_PATH) as f:
            data = json.load(f)

        if data["version"] == CACHE_VERSION:
            return {str(k): str(v) for k, v in data["icons"].items()}
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        pass

    return {}


def update_cache(icon_ids: dict[str, str]) -> None:
    os.makedirs(CACHE_DIR, exist_ok=True)

    # Stop concurrent runs from losing each other's picks
    with open(os.path.join(CACHE_DIR, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)

        data = {"version": CACHE_VERSION, "icons": {**read_cache(), **icon_ids}}

        fd, temp_path = tempfile.mkstemp(dir=CACHE_DIR, prefix=".icons-")

        try:
            with os.fdopen(fd, "w") as f:
                json.dump(data, f)

            os.replace(temp_path, CACHE_PATH)
        except OSError:
            os.unlink(temp_path)
            raise


if __name__ == "__main__":
    args = parse_arguments()

    if os.environ.get(WITH_SDK_ENV):
        # The run with the SDK only picks icons, its caller prints them.
        if (fm := load_model()) is not None:
            picked = asyncio.run(model_icon_ids(fm, args.names))
            if picked:
                update_cache(picked)

        sys.exit()

    icon_ids = read_cache()
    missing = [
        name
        for name in dict.fromkeys(args.names)
        if args.refresh or name not in icon_ids
    ]

    if missing and model_supported():
        if (warning := xcode_warning()) is None:
            pick_with_model(missing)
            icon_ids = read_cache()
        else:
            warn(*warning)

    # kitty may run this without a UTF-8 locale
    sys.stdout.reconfigure(encoding="utf-8")

    for name in args.names:
        icon_id = icon_ids.get(name)
        print(ICONS[icon_id][0] if icon_id in ICONS else hashed_icon(name))
