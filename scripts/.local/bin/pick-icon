    "harpoons": ("⇋", "sync, migration, exchange, two-way, ping, peer-to-peer"),
    "arrow-from-wall": ("⇰", "exports, piping, leaving, formatting"),
    "arrow-to-corner": ("⇱", "home, top level, back to the start"),
    "timer": ("⏱", "clock, scheduled jobs, cron jobs, measurement, timing"),
