#!/usr/bin/env -S uv run --script

# /// script
# requires-python = ">=3.10"
# dependencies = []
# [[tool.uv.index]]
# url = "https://pypi.org/simple"
# default = true
# ///

# Picks an icon to show next to a name, such as a renamed kitty tab.
#
# On macOS 26 and later, Apple's on-device model picks the icon whose meaning
# best matches the name. Elsewhere, or when the model is unavailable or declines
# to pick one, the icon is picked from a hash of the name. Either way a name
# always gets the same icon, as the model's picks are cached, until it is
# picked anew with --refresh.
#
# Apple's SDK is built from source and needs Xcode 26 or later, so it is only
# added to a second run of this script on Macs with it (see pick_with_model)
# rather than declared above, where a failing build would stop the script
# starting. Without it a warning is shown, in yellow when run from a terminal
# and otherwise as a notification only the first time for each kind of warning,
# and the icons are picked from hashes.

import argparse
import asyncio
import fcntl
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import zlib

# Model-based selection uses the name and description of each icon. Note adding or
# modifying the icon list causes all cached icons to be re-picked.
