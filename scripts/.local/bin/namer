        "Update with the Mac App Store to use Apple's on-device model."
    ),
    "xcode-license": (
        "Xcode license not accepted. Run 'sudo xcodebuild -license accept' "
        "to use Apple's on-device model."
    ),
    "sdk": (
        "Couldn't install or load Foundation Models SDK for Python. "
        "Run 'namer tab' in a terminal to see why."
    ),
    "d1": (
        "Couldn't install, download or load the d1-2B decision model. Icons are "
        "picked from hashes until it can be. Run 'namer icon test' in a terminal "
        "to see why."
    ),
    "model-disabled": (
        "Apple Intelligence not enabled. Turn on in System Settings > "
        "Apple Intelligence & Siri to use Apple's on-device model."
    ),
    "model-not-ready": (
        "Apple Intelligence model not ready, it may still be downloading. "
        "Tabs aren't named until it is."
    ),
    "model-unavailable": (
        "Apple Intelligence model unavailable. Tabs aren't named until it is."
    ),
}

# Warning kinds for the SDK's reasons the model is unavailable. Ineligible
# devices aren't warned about, like Macs without macOS 26.
MODEL_UNAVAILABLE_WARNINGS = {
    "APPLE_INTELLIGENCE_NOT_ENABLED": "model-disabled",
    "MODEL_NOT_READY": "model-not-ready",
    "UNKNOWN": "model-unavailable",
}

# Only send each kind of warning notification once - do not warn if its file exists
WARNED_PATH = os.path.join(CACHE_DIR, ".warned-{kind}")

GIT_TIMEOUT = 2  # seconds per git command
GIT_STATUS_LINES = 20
GIT_LOG_COMMITS = 8

app = typer.Typer(
    help="Name things with on-device models.",
    add_completion=False,
    no_args_is_help=True,
    # Tracebacks would otherwise show tab contexts, in the logs kitty keeps
    pretty_exceptions_show_locals=False,
)

# Set for the run of this script that has the models' libraries, see run_second
second_run = False

# Exit status of a second run that failed and printed why
REPORTED_FAILURE = 3


@app.callback()
def main(
    second: Annotated[bool, typer.Option("--second-run", hidden=True)] = False,
) -> None:
    global second_run
    second_run = second

    # kitty may run this without a UTF-8 locale
    sys.stdout.reconfigure(encoding="utf-8")


@app.command()
def icon(
    names: Annotated[list[str], typer.Argument(metavar="NAME...")],
    refresh: Annotated[
        bool,
        typer.Option(
            help="Have the model pick the names' icons anew rather than use cached ones."
        ),
    ] = False,
) -> None:
    """Print an icon for each name, one per line in the same order."""
    if second_run:
        # The second run only picks icons, its caller prints them.
        d1 = load_d1()
        update_cache({name: d1_icon_id(d1, name) for name in dict.fromkeys(names)})
        return

    icon_ids = read_cache()
    missing = [name for name in dict.fromkeys(names) if refresh or name not in icon_ids]

    if missing and d1_supported():
        run_second(["icon", "--", *missing], stdout=subprocess.DEVNULL)
        icon_ids = read_cache()

    for name in names:
        icon_id = icon_ids.get(name)
        print(ICONS[icon_id][0] if icon_id in ICONS else hashed_icon(name))


@app.command()
def tab(
    snapshot: Annotated[
        str,
        typer.Argument(metavar="SNAPSHOT", help="The snapshot's file, or - for stdin."),
    ] = "-",
    save_context: Annotated[
        Optional[Path],
        typer.Option(
            help="Save the context given to the models to this file, "
            "as a fixture for 'namer eval'."
        ),
    ] = None,
) -> None:
    """Name a kitty tab after the task it is being used for, printing JSON.

    The snapshot is JSON describing the tab's windows, as name_tab.py collects
    it: {"windows": [{"title", "cwd", "command", "last_command",
    "last_exit_status", "screen"}]}. The state of the Git repositories they
    are in is added to it.

    d1-2B decides whether the tab shows what the user is working on
    (purpose_p, its probability), and only then does the Foundation model name
    it and d1-2B pick the name's icon, which is cached. The label is null when
    either model finds no clear purpose.
    """
    if not second_run:
        if not d1_supported() or not sdk_buildable():
            print_error("ModelUnavailable", "The on-device models can't be used")
        if not run_second(sys.argv[1:], sdk=True):
            raise typer.Exit(1)
        return

    if (fm := load_model()) is None:
        print_error("ModelUnavailable", "Apple's on-device model is unavailable")

    d1 = load_d1_or_warn()

    # Failures here would otherwise be taken for the libraries failing, see run_second
    try:
        with open_text(snapshot) as f:
            context = tab_context(json.load(f))
    except (OSError, ValueError, AttributeError, TypeError) as e:
        print_error("InvalidSnapshot", f"{type(e).__name__}: {e}")

    if save_context is not None:
        save_context.write_text(context, encoding="utf-8")

    result = asyncio.run(name_tab(fm, d1, context))

    if "error" in result:
        print_error(result["error"], result["message"])

    if result["label"] is not None and result["icon_id"] is not None:
        update_cache({result["label"]: result["icon_id"]})

    print(json.dumps(result))


@app.command("eval")
def evaluate(
    fixtures: Annotated[
        Optional[list[str]],
        typer.Argument(
            metavar="FIXTURE...",
            help="Contexts saved by 'namer tab --save-context', or - for stdin "
            "(the default).",
            show_default=False,
        ),
    ] = None,
    repeat: Annotated[
        int, typer.Option("-n", "--repeat", help="Runs per fixture.")
    ] = 1,
    temperature: Annotated[
        Optional[float],
        typer.Option(
            "-t",
            "--temperature",
            help="The Foundation model's sampling temperature, 0.0 to 1.0.",
        ),
    ] = None,
    gate: Annotated[
        bool,
        typer.Option(
            help="Only name tabs d1-2B finds a purpose in, as 'namer tab' does; "
            "--no-gate names every tab, still reporting d1-2B's answer."
        ),
    ] = True,
    as_json: Annotated[
        bool, typer.Option("--json", help="Print one JSON object per run.")
    ] = False,
) -> None:
    """Name tabs from saved contexts, reporting tokens and timings, to test
    how sensibly, reliably and quickly the models name them.

    Icons picked here aren't cached.
    """
    if not second_run:
        if not d1_supported() or not sdk_buildable():
            raise typer.Exit(1)
        if not run_second(sys.argv[1:], sdk=True):
            raise typer.Exit(1)
        return

    started = time.perf_counter()
    if (fm := load_model()) is None:
        raise typer.Exit(REPORTED_FAILURE)
    d1 = load_d1_or_warn()

    model = fm.SystemLanguageModel()
    budget = model.context_size

    if not as_json:
        print(
            f"startup: {time.perf_counter() - started:.2f}s loading the models, "
            f"Foundation model context window {budget} tokens\n",
            flush=True,
        )

    for path in fixtures or ["-"]:
        # Failures here would otherwise be taken for the libraries failing, see run_second
        try:
            with open_text(path) as f:
                context = f.read()
        except OSError as e:
            print(f"Couldn't read {path}: {e}", file=sys.stderr)
            raise typer.Exit(REPORTED_FAILURE)

        tokens = asyncio.run(count_tokens(fm, model, context))

        for run in range(1, repeat + 1):
            result = asyncio.run(name_tab(fm, d1, context, temperature, gate))

            if as_json:
                print(
                    json.dumps(
                        {
                            "fixture": path,
                            "run": run,
                            "tokens": tokens,
                            "context_size": budget,
                            **result,
                        }
                    ),
                    flush=True,
                )
            else:
                print_report(path, run, tokens, budget, result)
                print(flush=True)


def print_error(error: str, message: str):
    """Print a failure as name_tab.py reads it and exit."""
    print(json.dumps({"error": error, "message": message}))
    raise typer.Exit(REPORTED_FAILURE if second_run else 1)


def open_text(path: str):
    return open(sys.stdin.fileno(), closefd=False) if path == "-" else open(path)


def hashed_icon(name: str) -> str:
    # zlib.crc32 gives a consistent int value that we can index with
    icons = list(ICONS.values())
    return icons[zlib.crc32(name.encode()) % len(icons)][0]


def d1_supported() -> bool:
    """Whether this is a Mac with Apple silicon, which MLX needs."""
    return sys.platform == "darwin" and platform.machine() == "arm64"


def model_supported() -> bool:
    """Whether this is a Mac with Apple's Foundation Models framework."""
    if sys.platform != "darwin":
        return False

    try:
        return int(platform.mac_ver()[0].split(".")[0]) >= 26
    except ValueError:
        return False


def xcode_warning() -> tuple[str, str] | None:
    """The kind and message of a warning if the active developer directory
    isn't a full Xcode 26 or later with its license accepted, which the SDK's
    build requires. Unlike running swift, xcode-select never offers to install
    the Command Line Tools."""
    try:
        developer_dir = subprocess.run(
            ["xcode-select", "-p"], capture_output=True, text=True, check=True
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        developer_dir = ""

    if not developer_dir or "CommandLineTools" in developer_dir:
        # The build doesn't use Xcode unless it's selected, even when installed
        if os.path.isdir(XCODE_DEVELOPER_DIR):
            return "xcode-unselected", WARNINGS["xcode-unselected"]

        return "xcode-missing", WARNINGS["xcode-missing"]

    xcodebuild = os.path.join(developer_dir, "usr/bin/xcodebuild")

    try:
        output = subprocess.run(
            [xcodebuild, "-version"],
            capture_output=True,
            text=True,
            check=True,
            timeout=30,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None  # Leave it to the build

    match = re.search(r"Xcode\s+(\d+)(\.\d+)*", output)

    if match and int(match.group(1)) < 26:
        version = match.group(0).split()[1]
        return "xcode-outdated", WARNINGS["xcode-outdated"].format(version=version)

    # Exits non-zero only when the license isn't accepted
    try:
        accepted = (
            subprocess.run(
                [xcodebuild, "-license", "check"], capture_output=True, timeout=30
            ).returncode
            == 0
        )
    except (OSError, subprocess.SubprocessError):
        return None  # Leave it to the build

    if not accepted:
        return "xcode-license", WARNINGS["xcode-license"]

    return None


def warn(kind: str, message: str | None = None) -> None:
    """Warns that the model isn't used, with WARNINGS[kind] unless a message
    is given."""
    message = message or WARNINGS[kind]

    if sys.stderr.isatty():
        print(f"\033[33m{message}\033[0m", file=sys.stderr)
        return

    # If this script is executed non-interactively (e.g. by kitty), notify that we aren't
    # using the Foundation model.
    warned_path = WARNED_PATH.format(kind=kind)

    if os.path.exists(warned_path):
        return

    try:
        os.makedirs(CACHE_DIR, exist_ok=True)

        with open(warned_path, "w"):
            pass

        subprocess.run(
            [
                "osascript",
                "-e",
                "on run argv",
                "-e",
                "display notification (item 1 of argv) with title (item 2 of argv)",
                "-e",
                "end run",
                message,
                "namer",
            ],
            capture_output=True,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def sdk_buildable() -> bool:
    """Whether the SDK can be built here, warning why not if Xcode is the
    reason."""
    if not model_supported():
        return False

    if (warning := xcode_warning()) is not None:
        warn(*warning)
        return False

    return True


def run_second(args: list[str], sdk: bool = False, stdout=None) -> bool:
    """Runs this script again with args and the models' libraries, d1-2B's and
    with sdk Apple's, which uv installs on first use and caches, returning
    whether that run succeeded. Its output and errors go wherever ours do, such
    as the logs name_tab.py keeps, unless stdout is given."""
    uv = os.environ.get("UV") or shutil.which("uv")

    if uv is None:
        return False

    libraries = [
        arg for dependency in D1_DEPENDENCIES for arg in ("--with", dependency)
    ]
    if sdk:
        libraries += ["--with", SDK]
    env = {**os.environ, "HF_HUB_DISABLE_TELEMETRY": "1"}
    if not sys.stderr.isatty():
        env["HF_HUB_DISABLE_PROGRESS_BARS"] = "1"  # kitty's logs, not a terminal

    result = subprocess.run(
        [uv, "run", "--quiet", *libraries, "--script", __file__, "--second-run", *args],
        env=env,
        stdout=stdout,
        check=False,
    )

    # Fails otherwise if uv can't install the libraries or that run can't load them
    if result.returncode not in (0, REPORTED_FAILURE):
        warn("sdk" if sdk else "d1")

    return result.returncode == 0


def load_model():
    """The Foundation Models SDK if the on-device model is available, otherwise
    warns why not. Errors loading the SDK are left to fail this run."""
    import apple_fm_sdk as fm

    available, reason = fm.SystemLanguageModel().is_available()

    if not available:
        if (kind := MODEL_UNAVAILABLE_WARNINGS.get(reason.name)) is not None:
            warn(kind)

        return None

    return fm


def load_d1():
    """d1-2B, downloaded on first use into the Hugging Face cache. Errors are
    left to fail this run."""
    import mlx.core as mx
    from huggingface_hub import snapshot_download
    from mlx_vlm import load

    # Pinned, so once downloaded the cached files are used without asking the Hub
    try:
        path = snapshot_download(
            D1_REPO,
            revision=D1_REVISION,
            allow_patterns=D1_FILES,
            local_files_only=True,
        )
    except Exception:  # not downloaded yet, or not all of it
        path = snapshot_download(D1_REPO, revision=D1_REVISION, allow_patterns=D1_FILES)
    model, _ = load(path)
    mx.set_cache_limit(MLX_CACHE_LIMIT)
    return model


def load_d1_or_warn():
    """d1-2B, or None with a warning if it can't be loaded, so that tabs are
    named without it: every tab the Foundation model finds a purpose in, and
    their icons picked from hashes."""
    try:
        return load_d1()
    except Exception as e:  # its download or any of its libraries
        print(f"Couldn't load d1-2B: {type(e).__name__}: {e}", file=sys.stderr)
        warn("d1")
        return None


def ask_d1(d1, state: str, question: dict) -> dict:
    return d1.system_one(state, {"q": question})["answers"]["q"]


def d1_icon_id(d1, name: str) -> str:
    probabilities = ask_d1(d1, f"Tab name: {name}", ICON_QUESTION)["probabilities"]
    return max(probabilities, key=probabilities.get)


def d1_purpose(d1, context: str) -> float:
    """d1-2B's probability that the tab shows what the user is working on."""
    return float(ask_d1(d1, context, PURPOSE_QUESTION)["noul"])


def read_cache() -> dict[str, str]:
    try:
        with open(CACHE_PATH) as f:
            data = json.load(f)

        if data["version"] == CACHE_VERSION:
            return {str(k): str(v) for k, v in data["icons"].items()}
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        pass

    return {}


def update_cache(icon_ids: dict[str, str]) -> None:
    os.makedirs(CACHE_DIR, exist_ok=True)

    # Stop concurrent runs from losing each other's picks
    with open(os.path.join(CACHE_DIR, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)

        data = {"version": CACHE_VERSION, "icons": {**read_cache(), **icon_ids}}

        fd, temp_path = tempfile.mkstemp(dir=CACHE_DIR, prefix=".icons-")

        try:
            with os.fdopen(fd, "w") as f:
                json.dump(data, f)

            os.replace(temp_path, CACHE_PATH)
        except OSError:
            os.unlink(temp_path)
            raise


def git(cwd: str, *args: str) -> str | None:
    try:
        result = subprocess.run(
            ["git", "-C", cwd, *args],
            capture_output=True,
            text=True,
            timeout=GIT_TIMEOUT,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout.rstrip() if result.returncode == 0 else None


def base_branch(root: str) -> str | None:
    """The branch the current one was likely made from."""
    if (
        default := git(root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    ) is not None:
        return default
    for branch in ("main", "master"):
        if git(root, "rev-parse", "--verify", "--quiet", branch) is not None:
            return branch
    return None


def repository_context(root: str) -> list[str]:
    branch = git(root, "branch", "--show-current") or "(detached)"
    lines = [f"## Git repository {home_relative(root)}", f"branch: {branch}"]

    status = (git(root, "status", "--short") or "").splitlines()
    lines.append("uncommitted changes:" if status else "uncommitted changes: none")
    lines += status[:GIT_STATUS_LINES]
    if len(status) > GIT_STATUS_LINES:
        lines.append(f"... and {len(status) - GIT_STATUS_LINES} more")

    # Only history that is likely this tab's own work, as the repository's
    # history would otherwise be taken as the tab's purpose: the branch's
    # commits, or on the base branch those not yet pushed. Every commit of a
    # repository without remotes is unpushed.
    base = base_branch(root)
    merge_base = git(root, "merge-base", "HEAD", base) if base else None
    if merge_base and branch not in (base, base.split("/")[-1]):
        if commits := git(
            root, "log", "--oneline", f"-{GIT_LOG_COMMITS}", f"{merge_base}..HEAD"
        ):
            lines += [f"commits on this branch, since {base}:", commits]
        if diff_stat := git(root, "diff", "--stat", merge_base):
            lines += [f"changes on this branch, since {base}:", diff_stat]
    elif commits := git(
        root, "log", "--oneline", f"-{GIT_LOG_COMMITS}", "HEAD", "--not", "--remotes"
    ):
        lines += ["unpushed commits:", commits]

    return lines


def home_relative(path: str) -> str:
    home = os.path.expanduser("~")
    return (
        "~" + path[len(home) :]
        if path == home or path.startswith(home + os.sep)
        else path
    )


def tab_context(snapshot: dict) -> str:
    """The context given to the model for a tab's snapshot, see tab."""
    windows = snapshot.get("windows") or []
    lines = ["## Tab"]
    roots: dict[str, None] = {}  # repository roots in window order

    for i, window in enumerate(windows, 1):
        cwd = window.get("cwd") or ""
        lines.append(
            f"window {i}: title {window.get('title', '')!r}, "
            f"cwd {home_relative(cwd)}, running: {window.get('command') or ''}"
        )
        if last_command := window.get("last_command"):
            lines.append(
                f"  last command: {last_command} "
                f"(exit status {window.get('last_exit_status')})"
            )
        if cwd and (root := git(cwd, "rev-parse", "--show-toplevel")):
            roots[root] = None

    for root in roots:
        lines += ["", *repository_context(root)]

    for i, window in enumerate(windows, 1):
        if screen := (window.get("screen") or "").rstrip():
            lines += ["", f"## Window {i} screen (last lines)", screen]

    return "\n".join(lines) + "\n"


def normalise_label(label: str | None) -> str | None:
    """The label as a tab's name, or None if it isn't one."""
    if not isinstance(label, str):
        return None

    # The model is asked for words separated by spaces, but sometimes joins
    # them with underscores, hyphens or CamelCase instead
    label = label.strip()

    if " " not in label:
        label = label.replace("_", " ").replace("-", " ")
        label = re.sub(r"(?<=[a-z0-9])(?=[A-Z])", " ", label)

    label = label.lower()

    # Without a clear purpose the model gives "none" as the label rather than null
    return label if label not in ("", "none", "null") else None


def tab_analysis(fm):
    """The class the Foundation model's analysis of a tab is generated as. Made
    here as the SDK is only loaded in the run that has it, and subclasses of
    generable classes lose their fields."""
    # Fields are generated in order, so the label follows the evidence for it.
    # The SDK only treats Optional[str], not str | None, as optional.
    annotations = {
        "key_datapoints": list[str],
        "has_clear_purpose": bool,
        "description": Optional[str],
        "label": Optional[str],
    }
    fields = {
        # No examples, such as the repository or branch, nor a minimum number
        # of items, as both had the model list or invent facts to show a purpose
        "key_datapoints": fm.guide(
            "Things the user has done in this tab that the snapshot shows, "
            "empty if none",
            max_items=6,
        ),
        "has_clear_purpose": fm.guide(
            "Whether the facts show specific work towards a task"
        ),
        "description": fm.guide(
            "One or two sentences describing the task and current activity, "
            "or none without a clear purpose"
        ),
        "label": fm.guide("Short task-oriented title, or none without a clear purpose"),
    }

    # The schema is shown to the model with the class name as its title, so the
    # name is a field that title can't be mistaken for, which it was when the
    # field was also called title.
    analysis = fm.generable(
        type("TabAnalysis", (), {**fields, "__annotations__": annotations})
    )

    # apple-fm-sdk 0.2.1 drops both the description given to @fm.generable and
    # the options given to respond(generating=...), so the schema is made with
    # its description here and passed to respond(schema=...) instead.
    return analysis, analysis.generation_schema(
        description="The task a terminal tab is being used for"
    )


async def name_tab(
    fm, d1, context: str, temperature: float | None = None, gate: bool = True
) -> dict:
    """The tab's name and icon, with the models' reasoning, or the error the
    Foundation model raised. Without d1-2B (None) every tab is named that the
    Foundation model finds a purpose in, and the icon is left to `namer icon`."""
    result = {
        "purpose_p": None,
        "purpose_threshold": PURPOSE_THRESHOLD,
        "purpose_seconds": None,
        "key_datapoints": None,
        "has_clear_purpose": None,
        "description": None,
        "raw_label": None,
        "label": None,
        "icon_id": None,
        "icon": None,
        "seconds": None,
        "icon_seconds": None,
    }

    if d1 is not None:
        started = time.perf_counter()
        result["purpose_p"] = round(d1_purpose(d1, context), 4)
        result["purpose_seconds"] = round(time.perf_counter() - started, 3)
        if gate and result["purpose_p"] < PURPOSE_THRESHOLD:
            return result

    analysis, schema = tab_analysis(fm)
    # A fresh session per run, so earlier runs don't influence later ones
    session = fm.LanguageModelSession(instructions=TAB_INSTRUCTIONS)
    options = fm.GenerationOptions(temperature=temperature)
    started = time.perf_counter()

    try:
        content = await session.respond(context, schema=schema, options=options)
        response = asdict(analysis._from_generated_content(content))
    except fm.FoundationModelsError as e:
        return {"error": type(e).__name__, "message": str(e)}

    result["seconds"] = round(time.perf_counter() - started, 3)
    label = (
        normalise_label(response["label"]) if response["has_clear_purpose"] else None
    )
    result.update(
        key_datapoints=response["key_datapoints"],
        has_clear_purpose=response["has_clear_purpose"],
        description=response["description"],
        raw_label=response["label"],
        label=label,
    )

    if label is not None and d1 is not None:
        started = time.perf_counter()
        result["icon_id"] = d1_icon_id(d1, label)
        result["icon"] = ICONS[result["icon_id"]][0]
        result["icon_seconds"] = round(time.perf_counter() - started, 3)

    return result


async def count_tokens(fm, model, context: str) -> dict[str, int]:
    """Tokens each part of a request to name a tab uses, which together with
    the response must fit in the Foundation model's context window. Empty if
    counting fails, so that the failure is reported by the run that follows."""
    _, schema = tab_analysis(fm)

    try:
        return {
            "instructions": await model.token_count(instructions=TAB_INSTRUCTIONS),
            "schema": await model.token_count(schema),
            "context": await model.token_count(context),
        }
    except fm.FoundationModelsError as e:
        print(f"Counting tokens failed: {type(e).__name__}: {e}", file=sys.stderr)
        return {}


def print_report(name: str, run: int, tokens: dict, budget: int, result: dict):
    used = sum(tokens.values())
    print(f"== {name} (run {run})")
    print(
        f"   tokens: {used}/{budget} before response "
        f"({', '.join(f'{part} {count}' for part, count in tokens.items())})"
    )

    if "error" in result:
        print(f"\033[31m   {result['error']}: {result['message']}\033[0m")
        return

    if result["purpose_p"] is not None:
        verdict = (
            "purpose" if result["purpose_p"] >= PURPOSE_THRESHOLD else "no purpose"
        )
        print(
            f"   d1-2B:       P(yes) {result['purpose_p']:.2f}, {verdict} "
            f"({result['purpose_seconds']:.2f}s)"
        )

    if result["seconds"] is None:
        print("   not named")
        return

    seconds = f"{result['seconds']:.2f}s"
    if result["icon_seconds"] is not None:
        seconds += f", then {result['icon_seconds']:.2f}s picking icon"
    print(f"   time:        {seconds}")

    for datapoint in result["key_datapoints"] or []:
        print(f"   - {datapoint}")

    print(f"   purpose:     {result['has_clear_purpose']}")
    print(f"   description: {result['description']}")
    label = f"\033[1m{result['label']}\033[0m"
    if result["raw_label"] != result["label"]:
        label += f" (given as {result['raw_label']!r})"
    print(f"   label:       {label}")
    if result["icon_id"] is not None:
        print(f"   icon:        {result['icon']} {result['icon_id']}")


if __name__ == "__main__":
    app()
