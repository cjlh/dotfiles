# d1-2B's questions, as evaluated in experiments/decision-model-evaluation.
# The icon is picked from the name alone, so a name gets the same icon however
# it was given.
ICON_QUESTION = {
    "type": "choice",
    "instructions": "Which icon's meaning best matches this tab name?",
    "criteria": {icon_id: meaning for icon_id, (_, meaning) in ICONS.items()},
}
PURPOSE_QUESTION = {
    "type": "noul",
    "instructions": "Has the user done something in this tab that shows what they "
    "are working on?",
}
# P(yes) from which a tab counts as having a purpose. With the Q8_0 build on
# llama.cpp, any threshold from 0.25 to 0.42 was right on 21 of the 22 tabs
# labelled in experiments/decision-model-evaluation. Each naming records P(yes)
# to revisit it.
PURPOSE_THRESHOLD = 0.25


@dataclass(frozen=True)
class Gguf:
    """A model file on the Hugging Face Hub, pinned to a revision."""

    name: str  # its name in llama-server, which requests give as "model"
    repo: str
    revision: str
    file: str
    size: int
    sha256: str

    @property
    def url(self) -> str:
        return f"https://huggingface.co/{self.repo}/resolve/{self.revision}/{self.file}"


# llama.cpp's first release with d1-2B (ggml-org/llama.cpp#31275), for macOS
# on Apple silicon. Its llama-server answers d1-2B's questions at /v1/systemone.
LLAMA_RELEASE = "b11945"
LLAMA_ARCHIVE_URL = (
    f"https://github.com/ggml-org/llama.cpp/releases/download/{LLAMA_RELEASE}/"
    f"llama-{LLAMA_RELEASE}-bin-macos-arm64.tar.gz"
)
LLAMA_ARCHIVE_SHA256 = "2499be768dfed7302dc596afa5606210769d27d4835eb2b32bf9655409b4b4f1"

D1 = Gguf(
    "d1",
    "LiquidAI/d1-2B-GGUF",
    "63be75e6586882defeb706ed4bda812d90256a6d",
    "d1-2B-Q8_0.gguf",
    1_846_240_576,
    "073313d92b53b0ac8193db6e906cb3c78a98183d244b15b7b8f5426115c6738c",
)
TITLEWEN_F16 = Gguf(
    "titlewen",
    "efficiencyx/Titlewen-GGUF",
    "732ed0c78601dfa07387718198b9c6068454319a",
    "qwen3-0.6b.F16.gguf",
    1_198_182_976,
    "0d402cf371be91fa73d18aa9552f6c979eda27ddee4b48e8f9d8d86140663890",
)

# llama-server's options for every model, then each model's own. d1-2B reads a
# question in one batch, so the batch holds the longest tab context.
LLAMA_CONTEXT = 8192  # tokens
LLAMA_MODEL_OPTIONS = {D1.name: {"b": LLAMA_CONTEXT, "ub": LLAMA_CONTEXT}}
# seconds; a request waits for its model to load, the first time from a
# release also for Metal's shaders to compile (about 10s)
LLAMA_REQUEST_TIMEOUT = 120
LLAMA_START_TIMEOUT = 30  # seconds for the router to listen
LLAMA_STOP_TIMEOUT = 10  # seconds before the server is killed
DOWNLOAD_TIMEOUT = 60  # seconds without data before a download fails


class TabNamingMode(str, Enum):
    """The model that names tabs."""

    titlewen_f16 = "titlewen_f16"
    apple_foundation = "apple_foundation"


# The GGUF of each naming mode run by llama-server
NAMING_GGUFS = {TabNamingMode.titlewen_f16: TITLEWEN_F16}

# Titlewen's chat template with no system prompt, which it isn't trained with,
# and the empty thinking block the template adds with thinking turned off
TITLEWEN_PROMPT = (
    "<|im_start|>user\n{context}<|im_end|>\n<|im_start|>assistant\n"
    "<think>\n\n</think>\n\n"
)
TITLEWEN_MAX_TOKENS = 24

TAB_INSTRUCTIONS = """\
You name terminal tabs. You are given a snapshot of one tab: its windows, \
their working directories and running programs, recent screen text and the \
state of any Git repositories they are in.

Infer the underlying task the user is working on, not the tools they are \
running. For example, name the feature being tested rather than "run tests", \
and the problem being investigated rather than "view logs".

Only use what the snapshot shows. Many tabs have no clear purpose, such as an \
idle shell, a fresh login, a system monitor or a shell just opened in a \
project, and that is a normal answer. Programs being open, a working \
directory, a repository, its name or being on its main branch, or a login \
message alone are not a purpose. A purpose needs something the user has \
actually done in this tab that shows what they are working on, not just where \
the tab is.

The title should be 1 to 4 lowercase words separated by spaces, naming the \
task as the user would name it themselves."""

