app = typer.Typer(
    help="Name things with on-device models.",
    add_completion=False,
    no_args_is_help=True,
    # Tracebacks would otherwise show tab contexts, in the logs kitty keeps
    pretty_exceptions_show_locals=False,
)

# Set for the run of this script that has the models' libraries, see run_second
second_run = False

# Exit status of a second run that failed and printed why
REPORTED_FAILURE = 3


@app.callback()
def main(
    second: Annotated[bool, typer.Option("--second-run", hidden=True)] = False,
) -> None:
    global second_run
    second_run = second

    # kitty may run this without a UTF-8 locale
    sys.stdout.reconfigure(encoding="utf-8")


@app.command()
def icon(
    names: Annotated[list[str], typer.Argument(metavar="NAME...")],
    refresh: Annotated[
        bool,
        typer.Option(
            help="Have the model pick the names' icons anew rather than use cached ones."
        ),
    ] = False,
) -> None:
    """Print an icon for each name, one per line in the same order."""
    icon_ids = read_cache()
    missing = [name for name in dict.fromkeys(names) if refresh or name not in icon_ids]

    if missing and llama_supported():
        try:
            with LlamaServer([D1]) as server:
                picked = {name: d1_icon_id(server, name) for name in missing}
        except LlamaError as e:
            print(f"Couldn't pick icons with d1-2B: {e}", file=sys.stderr)
            warn("llama")
        else:
            update_cache(picked)
            icon_ids.update(picked)

    for name in names:
        icon_id = icon_ids.get(name)
        print(ICONS[icon_id][0] if icon_id in ICONS else hashed_icon(name))


@app.command()
def tab(
    snapshot: Annotated[
        str,
        typer.Argument(metavar="SNAPSHOT", help="The snapshot's file, or - for stdin."),
    ] = "-",
    save_context: Annotated[
        Optional[Path],
        typer.Option(
            help="Save the context given to the models to this file, "
            "as a fixture for 'namer eval'."
        ),
    ] = None,
    model: Annotated[
        TabNamingMode, typer.Option(help="The model that names the tab.")
    ] = TabNamingMode.titlewen_f16,
) -> None:
    """Name a kitty tab after the task it is being used for, printing JSON.

    The snapshot is JSON describing the tab's windows, as name_tab.py collects
    it: {"windows": [{"title", "cwd", "command", "last_command",
    "last_exit_status", "screen"}]}. The state of the Git repositories they
    are in is added to it.

    d1-2B decides whether the tab shows what the user is working on
    (purpose_p, its probability) while the naming model names it, and d1-2B
    then picks the name's icon, which is cached. The label is null when either
    model finds no clear purpose.
    """
    if model == TabNamingMode.apple_foundation and not second_run:
        if not sdk_buildable():
            print_error("ModelUnavailable", "Apple's on-device model can't be used")
        if not run_second(sys.argv[1:]):
            raise typer.Exit(1)
        return

    if not llama_supported():
        print_error("ModelUnavailable", "llama.cpp's models need Apple silicon")

    fm = None
    if model == TabNamingMode.apple_foundation and (fm := load_model()) is None:
        print_error("ModelUnavailable", "Apple's on-device model is unavailable")

    # Failures here would otherwise be taken for the SDK failing, see run_second
    try:
        with open_text(snapshot) as f:
            context = tab_context(json.load(f))
    except (OSError, ValueError, AttributeError, TypeError) as e:
        print_error("InvalidSnapshot", f"{type(e).__name__}: {e}")

    if save_context is not None:
        save_context.write_text(context, encoding="utf-8")

    try:
        with LlamaServer(llama_models(model)) as server:
            result = name_tab(model, fm, server, context)
    except LlamaError as e:
        print(f"Couldn't use llama.cpp: {e}", file=sys.stderr)
        warn("llama")
        if fm is None:
            print_error("LlamaUnavailable", str(e))
        # Apple's model names the tab without d1-2B
        result = name_tab(model, fm, None, context)

    if "error" in result:
        print_error(result["error"], result["message"])

    if result["label"] is not None and result["icon_id"] is not None:
        update_cache({result["label"]: result["icon_id"]})

    print(json.dumps(result))


@app.command("eval")
def evaluate(
    fixtures: Annotated[
        Optional[list[str]],
        typer.Argument(
            metavar="FIXTURE...",
            help="Contexts saved by 'namer tab --save-context', or - for stdin "
            "(the default).",
            show_default=False,
        ),
    ] = None,
    repeat: Annotated[
        int, typer.Option("-n", "--repeat", help="Runs per fixture.")
    ] = 1,
    model: Annotated[
        TabNamingMode, typer.Option(help="The model that names the tabs.")
    ] = TabNamingMode.titlewen_f16,
    temperature: Annotated[
        Optional[float],
        typer.Option(
            "-t",
            "--temperature",
            help="The naming model's sampling temperature, 0.0 to 1.0. Titlewen "
            "picks the likeliest words by default, the Foundation model samples.",
        ),
    ] = None,
    gate: Annotated[
        bool,
        typer.Option(
            help="Only name tabs d1-2B finds a purpose in, as 'namer tab' does; "
            "--no-gate names every tab, still reporting d1-2B's answer."
        ),
    ] = True,
    as_json: Annotated[
        bool, typer.Option("--json", help="Print one JSON object per run.")
    ] = False,
) -> None:
    """Name tabs from saved contexts, reporting tokens and timings, to test
    how sensibly, reliably and quickly the models name them.

    Icons picked here aren't cached.
    """
    if model == TabNamingMode.apple_foundation and not second_run:
        if not sdk_buildable():
            raise typer.Exit(1)
        if not run_second(sys.argv[1:]):
            raise typer.Exit(1)
        return

    if not llama_supported():
        print("llama.cpp's models need Apple silicon", file=sys.stderr)
        raise typer.Exit(REPORTED_FAILURE if second_run else 1)

    started = time.perf_counter()
    fm = budget = None
    if model == TabNamingMode.apple_foundation:
        if (fm := load_model()) is None:
            raise typer.Exit(REPORTED_FAILURE)
        budget = fm.SystemLanguageModel().context_size

    try:
        with LlamaServer(llama_models(model)) as server:
            if not as_json:
                window = f", Foundation model context window {budget} tokens" if fm else ""
                print(
                    f"startup: {time.perf_counter() - started:.2f}s starting "
                    f"the models{window}\n",
                    flush=True,
                )

            for path in fixtures or ["-"]:
                # Failures here would otherwise be taken for the SDK failing, see run_second
                try:
                    with open_text(path) as f:
                        context = f.read()
                except OSError as e:
                    print(f"Couldn't read {path}: {e}", file=sys.stderr)
                    raise typer.Exit(REPORTED_FAILURE)

                tokens = asyncio.run(count_tokens(fm, context)) if fm else {}

                for run in range(1, repeat + 1):
                    result = name_tab(model, fm, server, context, temperature, gate)

                    if as_json:
                        print(
                            json.dumps(
                                {
                                    "fixture": path,
                                    "run": run,
                                    "tokens": tokens,
                                    "context_size": budget,
                                    **result,
                                }
                            ),
                            flush=True,
                        )
                    else:
                        print_report(path, run, tokens, budget, result)
                        print(flush=True)
    except LlamaError as e:
        print(f"Couldn't use llama.cpp: {e}", file=sys.stderr)
        raise typer.Exit(REPORTED_FAILURE if second_run else 1)


def print_error(error: str, message: str):
    """Print a failure as name_tab.py reads it and exit."""
    print(json.dumps({"error": error, "message": message}))
    raise typer.Exit(REPORTED_FAILURE if second_run else 1)


def open_text(path: str):
    return open(sys.stdin.fileno(), closefd=False) if path == "-" else open(path)


def hashed_icon(name: str) -> str:
    # zlib.crc32 gives a consistent int value that we can index with
    icons = list(ICONS.values())
    return icons[zlib.crc32(name.encode()) % len(icons)][0]


def llama_supported() -> bool:
    """Whether this is a Mac with Apple silicon, which llama.cpp's release
    is built for."""
    return sys.platform == "darwin" and platform.machine() == "arm64"


def model_supported() -> bool:
    """Whether this is a Mac with Apple's Foundation Models framework."""
    if sys.platform != "darwin":
        return False

    try:
        return int(platform.mac_ver()[0].split(".")[0]) >= 26
    except ValueError:
        return False


def xcode_warning() -> tuple[str, str] | None:
    """The kind and message of a warning if the active developer directory
    isn't a full Xcode 26 or later with its license accepted, which the SDK's
    build requires. Unlike running swift, xcode-select never offers to install
    the Command Line Tools."""
    try:
        developer_dir = subprocess.run(
            ["xcode-select", "-p"], capture_output=True, text=True, check=True
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        developer_dir = ""

    if not developer_dir or "CommandLineTools" in developer_dir:
        # The build doesn't use Xcode unless it's selected, even when installed
        if os.path.isdir(XCODE_DEVELOPER_DIR):
            return "xcode-unselected", WARNINGS["xcode-unselected"]

        return "xcode-missing", WARNINGS["xcode-missing"]

    xcodebuild = os.path.join(developer_dir, "usr/bin/xcodebuild")

    try:
        output = subprocess.run(
            [xcodebuild, "-version"],
            capture_output=True,
            text=True,
            check=True,
            timeout=30,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None  # Leave it to the build

    match = re.search(r"Xcode\s+(\d+)(\.\d+)*", output)

    if match and int(match.group(1)) < 26:
        version = match.group(0).split()[1]
        return "xcode-outdated", WARNINGS["xcode-outdated"].format(version=version)

    # Exits non-zero only when the license isn't accepted
    try:
        accepted = (
            subprocess.run(
                [xcodebuild, "-license", "check"], capture_output=True, timeout=30
            ).returncode
            == 0
        )
    except (OSError, subprocess.SubprocessError):
        return None  # Leave it to the build

    if not accepted:
        return "xcode-license", WARNINGS["xcode-license"]

    return None


def warn(kind: str, message: str | None = None) -> None:
    """Warns that the model isn't used, with WARNINGS[kind] unless a message
    is given."""
    message = message or WARNINGS[kind]

    if sys.stderr.isatty():
        print(f"\033[33m{message}\033[0m", file=sys.stderr)
        return

    # If this script is executed non-interactively (e.g. by kitty), notify that we aren't
    # using the Foundation model.
    warned_path = WARNED_PATH.format(kind=kind)

    if os.path.exists(warned_path):
        return

    try:
        os.makedirs(CACHE_DIR, exist_ok=True)

        with open(warned_path, "w"):
            pass

        subprocess.run(
            [
                "osascript",
                "-e",
                "on run argv",
                "-e",
                "display notification (item 1 of argv) with title (item 2 of argv)",
                "-e",
                "end run",
                message,
                "namer",
            ],
            capture_output=True,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def sdk_buildable() -> bool:
    """Whether the SDK can be built here, warning why not if Xcode is the
    reason."""
    if not model_supported():
        return False

    if (warning := xcode_warning()) is not None:
        warn(*warning)
        return False

    return True


def run_second(args: list[str]) -> bool:
    """Runs this script again with args and Apple's SDK, which uv builds on
    first use and caches, returning whether that run succeeded. Its output and
    errors go wherever ours do, such as the logs name_tab.py keeps."""
    uv = os.environ.get("UV") or shutil.which("uv")

    if uv is None:
        return False

    result = subprocess.run(
        [uv, "run", "--quiet", "--with", SDK, "--script", __file__, "--second-run", *args],
        check=False,
    )

    # Fails otherwise if uv can't install the SDK or that run can't load it
    if result.returncode not in (0, REPORTED_FAILURE):
        warn("sdk")

    return result.returncode == 0


def load_model():
    """The Foundation Models SDK if the on-device model is available, otherwise
    warns why not. Errors loading the SDK are left to fail this run."""
    import apple_fm_sdk as fm

    available, reason = fm.SystemLanguageModel().is_available()

    if not available:
        if (kind := MODEL_UNAVAILABLE_WARNINGS.get(reason.name)) is not None:
            warn(kind)

        return None

    return fm


class LlamaError(Exception):
    """llama.cpp or a model couldn't be downloaded, started or asked."""


def llama_models(mode: TabNamingMode) -> list[Gguf]:
    """The models llama-server runs to name tabs in a mode."""
    return [D1, *([NAMING_GGUFS[mode]] if mode in NAMING_GGUFS else [])]


def download(url: str, path: str, sha256: str, what: str) -> None:
    """Downloads url to path unless it is there, checking its sha256. Runs at
    the same time wait for each other's download rather than repeat it."""
    if os.path.exists(path):
        return

    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)

    with open(f"{path}.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)

        if os.path.exists(path):
            return

        if sys.stderr.isatty():
            print(f"Downloading {what}...", file=sys.stderr)

        fd, temp_path = tempfile.mkstemp(dir=directory, prefix=".download-")

        try:
            digest = hashlib.sha256()

            with os.fdopen(fd, "wb") as f, urllib.request.urlopen(
                url, timeout=DOWNLOAD_TIMEOUT
            ) as response:
                while chunk := response.read(2**20):
                    digest.update(chunk)
                    f.write(chunk)

            if digest.hexdigest() != sha256:
                raise LlamaError(f"{what} from {url} doesn't match its sha256")

            os.replace(temp_path, path)
        except OSError as e:
            raise LlamaError(f"Couldn't download {what} from {url}: {e}") from e
        finally:
            if os.path.exists(temp_path):
                os.unlink(temp_path)


def llama_server_path() -> str:
    """llama-server from llama.cpp's release, downloaded on first use."""
    directory = os.path.join(LLAMA_DIR, LLAMA_RELEASE)
    server = os.path.join(directory, "llama-server")

    if os.path.exists(server):
        return server

    archive = f"{directory}.tar.gz"
    download(LLAMA_ARCHIVE_URL, archive, LLAMA_ARCHIVE_SHA256, f"llama.cpp {LLAMA_RELEASE}")

    with open(f"{directory}.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)

        if not os.path.exists(server):
            temp_dir = tempfile.mkdtemp(dir=LLAMA_DIR, prefix=".extract-")

            try:
                with tarfile.open(archive) as tar:
                    # Refuses members that would land outside temp_dir
                    tar.extractall(temp_dir, filter="data")

                # The archive holds one directory of llama.cpp's programs and libraries
                os.replace(os.path.join(temp_dir, f"llama-{LLAMA_RELEASE}"), directory)
            except (OSError, tarfile.TarError) as e:
                raise LlamaError(f"Couldn't extract {archive}: {e}") from e
            finally:
                shutil.rmtree(temp_dir, ignore_errors=True)

        if os.path.exists(archive):
            os.unlink(archive)

    return server


def model_path(gguf: Gguf) -> str:
    """The model's file, downloaded on first use."""
    path = os.path.join(MODELS_DIR, gguf.repo.replace("/", "--"), gguf.revision, gguf.file)
    size = f"{gguf.size / 1e9:.1f} GB"
    download(gguf.url, path, gguf.sha256, f"{gguf.repo} {gguf.file} ({size})")
    return path


def llama_preset(paths: dict[str, str]) -> str:
    """llama-server's preset for the models at paths, by name, each loaded as
    the server starts."""
    lines = ["version = 1", "", "[*]", f"c = {LLAMA_CONTEXT}"]

    for name, path in paths.items():
        lines += ["", f"[{name}]", f"model = {path}", "load-on-startup = true"]
        lines += [f"{k} = {v}" for k, v in LLAMA_MODEL_OPTIONS.get(name, {}).items()]

    return "\n".join(lines) + "\n"


def free_port() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


# Runs llama-server until the run of namer that started it exits, even if it is
# killed: the router has no way to notice, unlike the server it starts for each
# model, which exits when the router does. Stops it on SIGTERM too. When namer
# exits first it can't have removed its temporary directory, which is removed
# here instead.
WATCHDOG = """\
import select, shutil, signal, subprocess, sys

parent, timeout, temp_dir, log_path, *args = sys.argv[1:]

with open(log_path, "ab") as log:
    server = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=log, stderr=log)


def stop(*_, orphaned=False):
    server.terminate()
    try:
        server.wait(int(timeout))
    except subprocess.TimeoutExpired:
        server.kill()
        server.wait()
    if orphaned:
        shutil.rmtree(temp_dir, ignore_errors=True)
    sys.exit(0)


signal.signal(signal.SIGTERM, stop)
queue = select.kqueue()
exits = [
    select.kevent(pid, select.KQ_FILTER_PROC, select.KQ_EV_ADD, select.KQ_NOTE_EXIT)
    for pid in (int(parent), server.pid)
]

try:
    queue.control(exits, 0)
except ProcessLookupError:  # either has already exited
    stop(orphaned=True)

while True:
    for event in queue.control(None, 1):
        if event.ident == server.pid:
            sys.exit(server.wait())
        stop(orphaned=True)
"""


class LlamaServer:
    """llama-server in router mode running models for the length of a with
    block, listening on a free local port with a key of its own. Each model is
    loaded as it starts, in a server process of its own, and a request for a
    model waits until it is loaded."""

    def __init__(self, models: list[Gguf]) -> None:
        self.models = models

    def __enter__(self) -> "LlamaServer":
        server = llama_server_path()
        paths = {gguf.name: model_path(gguf) for gguf in self.models}

        # Only readable by the user, as is the key in it
        self.temp_dir = tempfile.mkdtemp(prefix="namer-llama-")
        self.log_path = os.path.join(self.temp_dir, "llama-server.log")
        preset_path = os.path.join(self.temp_dir, "models.ini")
        key_path = os.path.join(self.temp_dir, "key")
        # The router otherwise also lists, and measures, models in llama.cpp's cache
        cache_dir = os.path.join(self.temp_dir, "cache")
        os.makedirs(cache_dir)

        with open(preset_path, "w") as f:
            f.write(llama_preset(paths))

        self.key = secrets.token_hex(16)

        with open(key_path, "w") as f:
            f.write(self.key + "\n")

        self.port = free_port()
        args = [
            server,
            "--host",
            "127.0.0.1",
            "--port",
            str(self.port),
            "--api-key-file",
            key_path,
            "--no-webui",
            "--models-preset",
            preset_path,
        ]
        self.watchdog = subprocess.Popen(
            [sys.executable, "-I", "-c", WATCHDOG, str(os.getpid()),
             str(LLAMA_STOP_TIMEOUT), self.temp_dir, self.log_path, *args],
            env={**os.environ, "LLAMA_CACHE": cache_dir},
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

        try:
            self.wait_until_listening()
        except BaseException:
            self.__exit__()
            raise

        return self

    def __exit__(self, *_) -> None:
        if self.watchdog.poll() is None:
            self.watchdog.send_signal(signal.SIGTERM)

            try:
                self.watchdog.wait(LLAMA_STOP_TIMEOUT + 5)
            except subprocess.TimeoutExpired:
                self.watchdog.kill()
                self.watchdog.wait()

        shutil.rmtree(self.temp_dir, ignore_errors=True)

    def wait_until_listening(self) -> None:
        deadline = time.monotonic() + LLAMA_START_TIMEOUT

        while time.monotonic() < deadline:
            if self.watchdog.poll() is not None:
                raise LlamaError(f"llama-server exited{self.log_tail()}")

            try:
                with urllib.request.urlopen(
                    f"http://127.0.0.1:{self.port}/health", timeout=1
                ) as response:
                    if response.status == 200:
                        return
            except OSError:
                pass

            time.sleep(0.02)

        raise LlamaError(f"llama-server didn't start listening{self.log_tail()}")

    def post(self, path: str, body: dict) -> dict:
        request = urllib.request.Request(
            f"http://127.0.0.1:{self.port}{path}",
            json.dumps(body).encode(),
            {"Content-Type": "application/json", "Authorization": f"Bearer {self.key}"},
        )

        try:
            with urllib.request.urlopen(request, timeout=LLAMA_REQUEST_TIMEOUT) as response:
                return json.load(response)
        except urllib.error.HTTPError as e:
            raise LlamaError(
                f"{path} failed with {e.code}: {e.read()[:500]!r}{self.log_tail()}"
            ) from e
        except (OSError, ValueError) as e:
            raise LlamaError(f"{path} failed: {e}{self.log_tail()}") from e

    def log_tail(self, lines: int = 20) -> str:
        try:
            with open(self.log_path, errors="replace") as f:
                tail = f.read().splitlines()[-lines:]
        except OSError:
            return ""

        return "".join(f"\n  {line}" for line in tail)


def ask_d1(server: LlamaServer, state: str, question: dict) -> dict:
    response = server.post(
        "/v1/systemone", {"model": D1.name, "state": state, "questions": {"q": question}}
    )

    try:
        return response["answers"]["q"]
    except (KeyError, TypeError) as e:
        raise LlamaError(f"d1-2B gave no answer: {response!r:.500}") from e


def d1_icon_id(server: LlamaServer, name: str) -> str:
    probabilities = ask_d1(server, f"Tab name: {name}", ICON_QUESTION)["probabilities"]
    return max(probabilities, key=probabilities.get)


def d1_purpose(server: LlamaServer, context: str) -> float:
    """d1-2B's probability that the tab shows what the user is working on."""
    return float(ask_d1(server, context, PURPOSE_QUESTION)["noul"])


def titlewen_title(
    server: LlamaServer, gguf: Gguf, context: str, temperature: float | None
) -> str:
    """Titlewen's title for the context, its likeliest unless a temperature
    is given."""
    response = server.post(
        "/v1/completions",
        {
            "model": gguf.name,
            "prompt": TITLEWEN_PROMPT.format(context=context),
            "max_tokens": TITLEWEN_MAX_TOKENS,
            "temperature": temperature or 0.0,
            "stop": ["<|im_end|>", "<|im_start|>"],
        },
    )

    try:
        text = response["choices"][0]["text"]
    except (KeyError, IndexError, TypeError) as e:
        raise LlamaError(f"Titlewen gave no title: {response!r:.500}") from e

    return (text.strip().splitlines() or [""])[0]


def read_cache() -> dict[str, str]:
    try:
        with open(CACHE_PATH) as f:
            data = json.load(f)

        if data["version"] == CACHE_VERSION:
            return {str(k): str(v) for k, v in data["icons"].items()}
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        pass

    return {}


def update_cache(icon_ids: dict[str, str]) -> None:
    os.makedirs(CACHE_DIR, exist_ok=True)

    # Stop concurrent runs from losing each other's picks
    with open(os.path.join(CACHE_DIR, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)

        data = {"version": CACHE_VERSION, "icons": {**read_cache(), **icon_ids}}

        fd, temp_path = tempfile.mkstemp(dir=CACHE_DIR, prefix=".icons-")

        try:
            with os.fdopen(fd, "w") as f:
                json.dump(data, f)

            os.replace(temp_path, CACHE_PATH)
        except OSError:
            os.unlink(temp_path)
            raise


def git(cwd: str, *args: str) -> str | None:
    try:
        result = subprocess.run(
            ["git", "-C", cwd, *args],
            capture_output=True,
            text=True,
            timeout=GIT_TIMEOUT,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout.rstrip() if result.returncode == 0 else None


def base_branch(root: str) -> str | None:
    """The branch the current one was likely made from."""
    if (
        default := git(root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    ) is not None:
        return default
    for branch in ("main", "master"):
        if git(root, "rev-parse", "--verify", "--quiet", branch) is not None:
            return branch
    return None


def repository_context(root: str) -> list[str]:
    branch = git(root, "branch", "--show-current") or "(detached)"
    lines = [f"## Git repository {home_relative(root)}", f"branch: {branch}"]

    status = (git(root, "status", "--short") or "").splitlines()
    lines.append("uncommitted changes:" if status else "uncommitted changes: none")
    lines += status[:GIT_STATUS_LINES]
    if len(status) > GIT_STATUS_LINES:
        lines.append(f"... and {len(status) - GIT_STATUS_LINES} more")

    # Only history that is likely this tab's own work, as the repository's
    # history would otherwise be taken as the tab's purpose: the branch's
    # commits, or on the base branch those not yet pushed. Every commit of a
    # repository without remotes is unpushed.
    base = base_branch(root)
    merge_base = git(root, "merge-base", "HEAD", base) if base else None
    if merge_base and branch not in (base, base.split("/")[-1]):
        if commits := git(
            root, "log", "--oneline", f"-{GIT_LOG_COMMITS}", f"{merge_base}..HEAD"
        ):
            lines += [f"commits on this branch, since {base}:", commits]
        if diff_stat := git(root, "diff", "--stat", merge_base):
            lines += [f"changes on this branch, since {base}:", diff_stat]
    elif commits := git(
        root, "log", "--oneline", f"-{GIT_LOG_COMMITS}", "HEAD", "--not", "--remotes"
    ):
        lines += ["unpushed commits:", commits]

    return lines


def home_relative(path: str) -> str:
    home = os.path.expanduser("~")
    return (
        "~" + path[len(home) :]
        if path == home or path.startswith(home + os.sep)
        else path
    )


def tab_context(snapshot: dict) -> str:
    """The context given to the model for a tab's snapshot, see tab."""
    windows = snapshot.get("windows") or []
    lines = ["## Tab"]
    roots: dict[str, None] = {}  # repository roots in window order

    for i, window in enumerate(windows, 1):
        cwd = window.get("cwd") or ""
        lines.append(
            f"window {i}: title {window.get('title', '')!r}, "
            f"cwd {home_relative(cwd)}, running: {window.get('command') or ''}"
        )
        if last_command := window.get("last_command"):
            lines.append(
                f"  last command: {last_command} "
                f"(exit status {window.get('last_exit_status')})"
            )
        if cwd and (root := git(cwd, "rev-parse", "--show-toplevel")):
            roots[root] = None

    for root in roots:
        lines += ["", *repository_context(root)]

    for i, window in enumerate(windows, 1):
        if screen := (window.get("screen") or "").rstrip():
            lines += ["", f"## Window {i} screen (last lines)", screen]

    return "\n".join(lines) + "\n"


def normalise_label(label: str | None) -> str | None:
    """The label as a tab's name, or None if it isn't one."""
    if not isinstance(label, str):
        return None

    # The model is asked for words separated by spaces, but sometimes joins
    # them with underscores, hyphens or CamelCase instead
    label = label.strip()

    if " " not in label:
        label = label.replace("_", " ").replace("-", " ")
        label = re.sub(r"(?<=[a-z0-9])(?=[A-Z])", " ", label)

    label = label.lower()

    # Without a clear purpose the model gives "none" as the label rather than null
    return label if label not in ("", "none", "null") else None


def tab_analysis(fm):
    """The class the Foundation model's analysis of a tab is generated as. Made
    here as the SDK is only loaded in the run that has it, and subclasses of
    generable classes lose their fields."""
    # Fields are generated in order, so the label follows the evidence for it.
    # The SDK only treats Optional[str], not str | None, as optional.
    annotations = {
        "key_datapoints": list[str],
        "has_clear_purpose": bool,
        "description": Optional[str],
        "label": Optional[str],
    }
    fields = {
        # No examples, such as the repository or branch, nor a minimum number
        # of items, as both had the model list or invent facts to show a purpose
        "key_datapoints": fm.guide(
            "Things the user has done in this tab that the snapshot shows, "
            "empty if none",
            max_items=6,
        ),
        "has_clear_purpose": fm.guide(
            "Whether the facts show specific work towards a task"
        ),
        "description": fm.guide(
            "One or two sentences describing the task and current activity, "
            "or none without a clear purpose"
        ),
        "label": fm.guide("Short task-oriented title, or none without a clear purpose"),
    }

    # The schema is shown to the model with the class name as its title, so the
    # name is a field that title can't be mistaken for, which it was when the
    # field was also called title.
    analysis = fm.generable(
        type("TabAnalysis", (), {**fields, "__annotations__": annotations})
    )

    # apple-fm-sdk 0.2.1 drops both the description given to @fm.generable and
    # the options given to respond(generating=...), so the schema is made with
    # its description here and passed to respond(schema=...) instead.
    return analysis, analysis.generation_schema(
        description="The task a terminal tab is being used for"
    )


async def foundation_analysis(fm, context: str, temperature: float | None) -> dict:
    """The Foundation model's analysis of the tab, see tab_analysis."""
    analysis, schema = tab_analysis(fm)
    # A fresh session per run, so earlier runs don't influence later ones
    session = fm.LanguageModelSession(instructions=TAB_INSTRUCTIONS)
    options = fm.GenerationOptions(temperature=temperature)
    content = await session.respond(context, schema=schema, options=options)
    return asdict(analysis._from_generated_content(content))


def timed(function, *args):
    """function(*args) and the seconds it took."""
    started = time.perf_counter()
    value = function(*args)
    return value, round(time.perf_counter() - started, 3)


def name_tab(
    mode: TabNamingMode,
    fm,
    server: LlamaServer | None,
    context: str,
    temperature: float | None = None,
    gate: bool = True,
) -> dict:
    """The tab's name and icon, with the models' reasoning, or the error the
    Foundation model raised. d1-2B decides whether the tab has a purpose while
    the naming model names it, so that a tab with one is named sooner. Without
    the server (None), only in the Foundation model's mode, every tab is named
    that it finds a purpose in, and the icon is left to `namer icon`."""
    result = {
        "model": mode.value,
        "purpose_p": None,
        "purpose_threshold": PURPOSE_THRESHOLD,
        "purpose_seconds": None,
        "key_datapoints": None,
        "has_clear_purpose": None,
        "description": None,
        "raw_label": None,
        "label": None,
        "icon_id": None,
        "icon": None,
        "seconds": None,
        "icon_seconds": None,
    }

    with ThreadPoolExecutor(1) as pool:
        purpose = pool.submit(timed, d1_purpose, server, context) if server else None

        if mode == TabNamingMode.apple_foundation:
            try:
                response, seconds = timed(
                    asyncio.run, foundation_analysis(fm, context, temperature)
                )
            except fm.FoundationModelsError as e:
                return {"error": type(e).__name__, "message": str(e)}

            raw_label = response["label"]
            has_purpose = response["has_clear_purpose"]
            result.update(
                key_datapoints=response["key_datapoints"],
                has_clear_purpose=has_purpose,
                description=response["description"],
            )
        else:
            raw_label, seconds = timed(
                titlewen_title, server, NAMING_GGUFS[mode], context, temperature
            )
            has_purpose = True  # Titlewen names every tab, d1-2B decides

        if purpose is not None:
            purpose_p, result["purpose_seconds"] = purpose.result()
            result["purpose_p"] = round(purpose_p, 4)
            if gate and purpose_p < PURPOSE_THRESHOLD:
                has_purpose = False

    result.update(
        raw_label=raw_label,
        label=normalise_label(raw_label) if has_purpose else None,
        seconds=seconds,
    )

    if result["label"] is not None and server is not None:
        result["icon_id"], result["icon_seconds"] = timed(
            d1_icon_id, server, result["label"]
        )
        result["icon"] = ICONS[result["icon_id"]][0]

    return result


async def count_tokens(fm, context: str) -> dict[str, int]:
    """Tokens each part of a request to name a tab uses, which together with
    the response must fit in the Foundation model's context window. Empty if
    counting fails, so that the failure is reported by the run that follows."""
    _, schema = tab_analysis(fm)
    model = fm.SystemLanguageModel()

    try:
        return {
            "instructions": await model.token_count(instructions=TAB_INSTRUCTIONS),
            "schema": await model.token_count(schema),
            "context": await model.token_count(context),
        }
    except fm.FoundationModelsError as e:
        print(f"Counting tokens failed: {type(e).__name__}: {e}", file=sys.stderr)
        return {}


def print_report(
    name: str, run: int, tokens: dict, budget: int | None, result: dict
) -> None:
    print(f"== {name} (run {run})")
    if tokens:
        print(
            f"   tokens: {sum(tokens.values())}/{budget} before response "
            f"({', '.join(f'{part} {count}' for part, count in tokens.items())})"
        )

    if "error" in result:
        print(f"\033[31m   {result['error']}: {result['message']}\033[0m")
        return

    if result["purpose_p"] is not None:
        verdict = (
            "purpose" if result["purpose_p"] >= PURPOSE_THRESHOLD else "no purpose"
        )
        print(
            f"   d1-2B:       P(yes) {result['purpose_p']:.2f}, {verdict} "
            f"({result['purpose_seconds']:.2f}s)"
        )

    seconds = f"{result['seconds']:.2f}s naming"
    if result["icon_seconds"] is not None:
        seconds += f", then {result['icon_seconds']:.2f}s picking icon"
    print(f"   time:        {seconds}")

    for datapoint in result["key_datapoints"] or []:
        print(f"   - {datapoint}")

    if result["has_clear_purpose"] is not None:
        print(f"   purpose:     {result['has_clear_purpose']}")
        print(f"   description: {result['description']}")

    if result["label"] is None:
        print(f"   not named (given {result['raw_label']!r})")
        return

    label = f"\033[1m{result['label']}\033[0m"
    if result["raw_label"] != result["label"]:
        label += f" (given as {result['raw_label']!r})"
    print(f"   label:       {label}")
    if result["icon_id"] is not None:
        print(f"   icon:        {result['icon']} {result['icon_id']}")


if __name__ == "__main__":
    app()
