#!/usr/bin/env -S uv run --quiet --script

# /// script
# requires-python = ">=3.10"
# dependencies = ["typer==0.27.3"]
# [[tool.uv.index]]
# url = "https://pypi.org/simple"
# default = true
# ///

# Names things with Apple's on-device model: picks icons to show next to names,
# such as renamed kitty tabs, and names kitty tabs after the task they are
# being used for.
#
# On macOS 26 and later, the model picks the icon whose meaning best matches a
# name. Elsewhere, or when the model is unavailable or declines to pick one, the
# icon is picked from a hash of the name. Either way a name always gets the same
# icon, as the model's picks are cached, until it is picked anew with --refresh
# or by naming a tab with that name.
#
# Apple's SDK is built from source and needs Xcode 26 or later, so it is only
# added to a second run of this script on Macs with it (see run_with_sdk)
# rather than declared above, where a failing build would stop the script
# starting. Without it a warning is shown, in yellow when run from a terminal
# and otherwise as a notification only the first time for each kind of warning,
# icons are picked from hashes and tabs aren't named. See:
# https://apple.github.io/python-apple-fm-sdk/

import asyncio
import fcntl
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import time
import zlib
from dataclasses import asdict
from enum import Enum
from pathlib import Path
from typing import Annotated, Optional

import typer

# Model-based selection uses the name and description of each icon. Note adding or
