#!/usr/bin/env -S uv run --quiet --script

# /// script
# requires-python = ">=3.10"
# dependencies = ["typer==0.27.3"]
# [[tool.uv.index]]
# url = "https://pypi.org/simple"
# default = true
# ///

# Names things with on-device models: picks icons to show next to names, such as
# renamed kitty tabs, and names kitty tabs after the task they are being used
# for.
#
# On Apple silicon, LiquidAI's d1-2B decision model picks the icon whose meaning
# best matches a name, and decides whether a tab shows enough of what the user
# is doing to name it. Apple's on-device Foundation model, on macOS 26 and
# later, writes the name. Without d1-2B icons are picked from a hash of the
# name, and without the Foundation model tabs aren't named. Either way a name
# always gets the same icon, as icons are cached, until it is picked anew with
# --refresh or by naming a tab with that name.
#
# The models' libraries are only added to a second run of this script (see
# run_second) rather than declared above, where a failing install would stop
# the script starting: d1-2B's on Apple silicon, and when naming a tab also
# Apple's SDK, which is built from source and needs Xcode 26 or later. Their
# first install takes a while, and d1-2B (1.35 GB) is downloaded on first use.
# Without them a warning is shown, in yellow when run from a terminal and
# otherwise as a notification only the first time for each kind of warning.
# See: https://apple.github.io/python-apple-fm-sdk/ and
# https://huggingface.co/LiquidAI/d1-2B-MLX-4bit

import asyncio
import fcntl
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import time
import zlib
from dataclasses import asdict
from pathlib import Path
from typing import Annotated, Optional

import typer

