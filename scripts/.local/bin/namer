#!/usr/bin/env -S uv run --quiet --script

# /// script
# requires-python = ">=3.10"
# dependencies = ["typer==0.27.3"]
# [[tool.uv.index]]
# url = "https://pypi.org/simple"
# default = true
# ///

# Names things with on-device models: picks icons to show next to names, such as
# renamed kitty tabs, and names kitty tabs after the task they are being used
# for.
#
# On Apple silicon, LiquidAI's d1-2B decision model picks the icon whose meaning
# best matches a name, and decides whether a tab shows enough of what the user
# is doing to name it. The name is written by the model --model picks:
# Titlewen, a small title model, or Apple's on-device Foundation model on macOS
# 26 and later. Without d1-2B icons are picked from a hash of the name, and
# without the naming model tabs aren't named. Either way a name always gets the
# same icon, as icons are cached, until it is picked anew with --refresh or by
# naming a tab with that name.
#
# d1-2B and Titlewen run in llama.cpp's llama-server, one server per run in its
# router mode, which serves each model from a process of its own (see
# LlamaServer). On first use namer downloads a pinned llama.cpp release (16 MB)
# and the models' GGUF files (d1-2B 1.8 GB, Titlewen 1.2 GB), checking each
# against its sha256, into its cache directory.
#
# Apple's SDK is only added to a second run of this script (see run_second)
# rather than declared above, where a failing install would stop the script
# starting. It is built from source, which takes a while and needs Xcode 26 or
# later. Without a model a warning is shown, in yellow when run from a terminal
# and otherwise as a notification only the first time for each kind of
# warning.
# See: https://github.com/ggml-org/llama.cpp/tree/master/tools/server,
# https://huggingface.co/LiquidAI/d1-2B-GGUF,
# https://huggingface.co/efficiencyx/Titlewen-GGUF and
# https://apple.github.io/python-apple-fm-sdk/

import asyncio
import fcntl
import hashlib
import json
import os
import platform
import re
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.request
import zlib
from concurrent.futures import ThreadPoolExecutor
from dataclasses import asdict, dataclass
from enum import Enum
from pathlib import Path
from typing import Annotated, Optional

import typer

