    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "namer"
)

CACHE_PATH = os.path.join(CACHE_DIR, "icons.json")

# Changing the icons, the question, the model or llama.cpp invalidates the cache
CACHE_VERSION = zlib.crc32(
    json.dumps([ICONS, ICON_QUESTION, asdict(D1), LLAMA_RELEASE]).encode()
)

# llama.cpp's release and the models' files, each in a directory or file named
# after its version so that a new one is downloaded beside the old
LLAMA_DIR = os.path.join(CACHE_DIR, "llama.cpp")
MODELS_DIR = os.path.join(CACHE_DIR, "models")

